# ─── Formspree ───────────────────────────────────────────────
# Get your form ID from https://formspree.io
# Example: https://formspree.io/f/xabcdefg → ID is "xabcdefg"
NEXT_PUBLIC_FORMSPREE_ID=your_formspree_form_id

# ─── Site URL ────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://codingvibes.dev

# ─── WhatsApp ────────────────────────────────────────────────
# Your WhatsApp number with country code, WITHOUT the + sign
# Example: 970591234567 for +970 59 123 4567
NEXT_PUBLIC_WHATSAPP_NUMBER=970XXXXXXXXX
